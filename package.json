{
  "name": "wisplight",
  "version": "0.0.1",
  "private": true,
  "description": "A single-player text RPG set in the Nethermarch, where every NPC is driven by AI.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "editor": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "web": "vite --config vite.web.config.ts",
    "play": "tsx src/cli/play.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/cli/sim.ts",
    "balance": "tsx scripts/balance.ts",
    "reference": "tsx scripts/reference.ts",
    "ids": "tsx scripts/ids.ts",
    "worldbook": "tsx scripts/worldbook.ts",
    "longrun": "tsx scripts/longrun.ts",
    "stutter": "tsx scripts/stutter.ts",
    "playtest": "tsx scripts/playtest.ts",
    "content:contract": "tsx scripts/contract.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "author": "Bram Vos"
}
