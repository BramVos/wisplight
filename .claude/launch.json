{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wisplight-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web"
      ],
      "port": 5199
    },
    {
      "name": "worldbook-pages",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5311",
        "--bind",
        "127.0.0.1",
        "--directory",
        "out/worldbook"
      ],
      "port": 5311
    }
  ]
}
